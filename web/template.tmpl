import asyncio
from pathlib import Path, PurePosixPath
import platform
import stat
import sys
import unicodedata


def _validated_archive_members(members):
    """Return one collision-free portable regular-file namespace."""

    invalid_component_characters = frozenset('<>:"\\|?*')
    reserved_basenames = frozenset(
        {"con", "prn", "aux", "nul"}
        | {f"com{number}" for number in range(1, 10)}
        | {f"lpt{number}" for number in range(1, 10)}
    )
    exact_names = set()
    portable_paths = {}
    validated = []
    for member in members:
        name = member.filename
        member_path = PurePosixPath(name)
        member_mode = member.external_attr >> 16
        drive_prefixed = len(name) >= 2 and name[0].isalpha() and name[1] == ":"
        if (
            not name
            or "\\" in name
            or drive_prefixed
            or member_path.is_absolute()
            or member_path.as_posix() != name
            or any(part in {"", ".", ".."} for part in member_path.parts)
            or any(ord(character) < 32 or ord(character) == 127 for character in name)
            or not stat.S_ISREG(member_mode)
            or stat.S_ISLNK(member_mode)
        ):
            raise RuntimeError(f"unsafe application archive member: {name}")
        for component in member_path.parts:
            reserved_basename = unicodedata.normalize(
                "NFKC", component.split(".", 1)[0]
            ).casefold()
            if (
                component.endswith((".", " "))
                or any(character in invalid_component_characters for character in component)
                or reserved_basename in reserved_basenames
            ):
                raise RuntimeError(f"unsafe application archive member: {name}")
        if name in exact_names:
            raise RuntimeError(f"archive path collision: duplicate member {name!r}")
        exact_names.add(name)
        parts = member_path.parts
        for length in range(1, len(parts) + 1):
            original = "/".join(parts[:length])
            portable_key = "/".join(
                unicodedata.normalize("NFKC", part).casefold()
                for part in parts[:length]
            )
            current = (original, length == len(parts))
            previous = portable_paths.get(portable_key)
            if previous is None:
                portable_paths[portable_key] = current
            elif previous != current:
                raise RuntimeError(
                    f"archive path collision: {previous[0]!r} conflicts with {original!r}"
                )
        validated.append(member)
    return tuple(validated)


# Pygbag 0.9.3 discovers this exact coroutine name from its template loader.
async def custom_site():
    import embed

    platform.document.body.style.background = "#10231e"
    platform.window.transfer.hidden = true
    platform.window.canvas.style.visibility = "visible"
    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    import zipfile

    async with platform.fopen("{{cookiecutter.archive}}.apk", "rb") as archive:
        with zipfile.ZipFile(archive) as zip_ref:
            members = _validated_archive_members(tuple(zip_ref.infolist()))
            zip_ref.extractall(appdir.as_posix(), members=members)

    platform.run_main(PyConfig, loaderhome=appdir / "assets", loadermain=None)
    while embed.counter() < 0:
        await asyncio.sleep(0.1)

    main = appdir / "assets" / "main.py"
    if not platform.window.MM.UME:
        __import__(__name__).__file__ = main
        platform.window.infobox.innerText = "Ready — click the game to enable audio"
        while not platform.window.MM.UME:
            await asyncio.sleep(0.1)

    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)
    __import__(__name__).__file__ = main

    def ui_callback(package):
        platform.window.infobox.innerText = f"Preparing {package}"

    await shell.source(main, callback=ui_callback)
    platform.window.infobox.style.display = "none"
    platform.window.config.gui_divider = 1
    platform.window.window_resize()
    shell.interactive()


asyncio.run(custom_site())

